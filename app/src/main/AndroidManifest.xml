<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 导航按钮需要检测/拉起高德地图 App，Android 11+ 包可见性限制下不声明这个的话，
         即使安装了高德地图，resolveActivity 也可能查不到，误判成未安装 -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="androidamap" />
        </intent>
        <!-- vivo/iQOO 自启动+后台弹出界面管理页所在的包：用显式ComponentName跳转虽然
             不强制要求声明这个，但不同Android版本对包可见性处理细节有出入，加上更保险 -->
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.vivo.abe" />
    </queries>

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera.any" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 摇一摇/NFC 记账时自动定位用：按高德官方文档要求，Android 12+ 上不能单独只请求 FINE，
         要和 COARSE 一起请求，否则部分系统版本会忽略请求 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 摇一摇记账默认开启后，用来在设备重启时重新拉起前台监听服务（配合 BootCompletedReceiver） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 摇一摇记账用：前台Service必需的基础权限 + Android 14 specialUse 类型专属权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 摇一摇触发用 AlarmManager.setAlarmClock() 无感拉起Activity，这个API本身也要精确闹钟权限
         （之前以为它能豁免，实测线上报了SecurityException，已确认是三个exact alarm API都要）。
         【202609二次修复】USE_EXACT_ALARM 是普通权限，装上就自动授予、不可被用户撤销（除非卸载），
         不需要像 SCHEDULE_EXACT_ALARM 那样再单独跳系统设置页引导用户手动开——Google Play 对
         USE_EXACT_ALARM 有“必须是日历/闹钟类核心功能App”的上架审核限制，但这个App不上架，
         纯个人签名安装，不受这条约束。两个权限一起声明：USE_EXACT_ALARM 覆盖 Android 13+，
         SCHEDULE_EXACT_ALARM 在 Android 12/12L 上同样是装上自动给，双重保险覆盖 Android 12 起的全部版本。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExpenseTracker"
        android:usesCleartextTraffic="true">

        <!-- 高德地图/定位/搜索 SDK 公用的 Key，值从 build.gradle 里的 manifestPlaceholders 注入，
             实际值来自 local.properties 里的 AMAP_KEY 一行，不硬编码在这里 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_KEY}" />

        <!-- 首页 Dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".pet.PetActivity"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name=".QuickLogActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TransparentLog">

            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/com.monsieurmahjong.iqoowang.quicklog" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="quicklog"
                    android:scheme="iqoowang" />
            </intent-filter>

            <!-- 【修复】NFC 扫描触发的系统广播 action 永远是 NDEF_DISCOVERED，不是 ACTION_VIEW；
                 上面那个 ACTION_VIEW 过滤器只对"点击超链接"这类场景有效，对扫标签无效。
                 用 NFC Tools 这类工具写的 URL/URI 类型记录，实际触发的是这条。 -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="quicklog"
                    android:scheme="iqoowang" />
            </intent-filter>

        </activity>
        <activity
            android:name=".HistoryGalleryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TransparentLog"></activity>
        <activity
            android:name=".DayDetailActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TransparentLog"></activity>
        <activity
            android:name=".search.SearchActivity"
            android:exported="false" />
        <activity
            android:name=".map.LocationMapActivity"
            android:exported="false" />
        <activity
            android:name=".map.LocationPickerActivity"
            android:exported="false" />
        <activity
            android:name=".map.MapExploreActivity"
            android:exported="false" />
        <!-- 【202609 新增】原生高清街区图层，目前还只接 Mock 数据、没接入导航流程，
             不影响现有 map_explore.html 那套流程正常使用 -->
        <activity
            android:name=".map.DistrictStreetMapActivity"
            android:exported="true" />
        <activity
            android:name=".piggy.PiggyBankActivity"
            android:exported="false" />
        <activity
            android:name=".streak.StreakActivity"
            android:exported="false" />
        <activity
            android:name=".BatchImportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NfcTriggerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="action"
                    android:scheme="macproxy" />
            </intent-filter>

        </activity>
        <!-- 开机自启摇一摇监听：只监听系统受保护广播，exported=true 不会被第三方App伪造触发 -->
        <receiver
            android:name=".service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- AlarmManager.setAlarmClock() 的投递目标：只由本App自己创建的PendingIntent触发，
             不挂intent-filter、exported=false，外部App拿不到触发它的途径 -->
        <receiver
            android:name=".service.ShakeTrampolineReceiver"
            android:enabled="true"
            android:exported="false" />
        <service
            android:name=".service.ShakeDetectService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="shake_gesture_quick_expense_logging" />
        </service>
        <service
            android:name=".server.ScreenshotService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>