<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#212836" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="@color/cyber_card_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_card_inner" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/cyber_card_stroke" />
        </shape>
    </item>
</selector>
