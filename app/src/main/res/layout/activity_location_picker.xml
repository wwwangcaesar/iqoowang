<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E17">

    <!-- 上半部分：高德地图 + 中心图钉 + 顶部操作条 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.amap.api.maps.MapView
            android:id="@+id/lp_map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 中心固定图钉：视觉上钉在地图中央 -->
        <TextView
            android:id="@+id/lp_pin_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:text="📍"
            android:textSize="36sp"
            android:elevation="8dp" />

        <!-- 顶部操作栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="28dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lp_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#CC0A0E17"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="✕ 取消"
                android:textColor="#00FFC6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginStart="8dp"
                android:background="#CC0A0E17"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="拖动地图选择附近地点"
                android:textColor="#AACFE8"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 下半部分：当前选中的地点 + 附近 POI 列表 + 确认按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#121824"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 当前选中地点卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A2232"
            android:padding="12dp">

            <TextView
                android:id="@+id/lp_tv_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在解析附近地点…"
                android:textColor="#00FFC6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/lp_tv_coords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="附近地点（点击可直接切换）"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- 附近 POI 列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lp_rv_pois"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never" />

        <!-- 确认校准按钮 -->
        <Button
            android:id="@+id/lp_btn_confirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#00FFC6"
            android:text="确认校准为此地点"
            android:textColor="#0A0E17"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
