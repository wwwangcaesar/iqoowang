<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/ll_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:textColor="@color/purple_200"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2026年"
            android:background="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="#00FFC6"
            />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A2233"
        android:visibility="visible">

        <View
            android:id="@+id/v_ratio"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_status_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerInside"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="@id/v_ratio"
            app:layout_constraintEnd_toEndOf="@id/v_ratio"
            app:layout_constraintStart_toStartOf="@id/v_ratio"
            app:layout_constraintTop_toTopOf="@id/v_ratio" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/v_ratio"
            app:layout_constraintEnd_toEndOf="@id/v_ratio"
            app:layout_constraintStart_toStartOf="@id/v_ratio"
            app:layout_constraintTop_toTopOf="@id/v_ratio">

            <TextView
                android:id="@+id/tv_grid_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A99AD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_grid_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:transitionName="transition_amount"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
