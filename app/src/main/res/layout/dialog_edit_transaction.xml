<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#E5E9EB"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_edit_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="修改账单明细"
        android:textColor="#064E3B"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="#80bea6"
        app:hintTextColor="#80bea6"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_edit_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="#064E3B"
            android:hint="消费金额 (元)" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 消费分类：单选下拉菜单（点击弹出已有分类列表，不允许直接自由输入） -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxStrokeColor="#80bea6"
        app:hintTextColor="#80bea6"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

        <AutoCompleteTextView
            android:id="@+id/et_edit_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="#064E3B"
            android:hint="消费分类" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:boxStrokeColor="#80bea6"
        app:hintTextColor="#80bea6"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_edit_remark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#505F76"
            android:hint="添加备注 (选填)" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 位置信息：只有摇一摇/NFC记账时自动定位到的记录才会显示这一行（默认gone，
         运行时根据是否有经纬度决定）。长按可改名，点击跳转地图页面。 -->
    <TextView
        android:id="@+id/tv_edit_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textColor="#2E7D32"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_save_changes"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#80bea6"
        android:text="保存修改"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</LinearLayout>
