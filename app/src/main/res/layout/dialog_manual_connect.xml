<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cyber_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 弹窗顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="[ 手动直连与诊断 ]"
            android:textColor="@color/cyber_neon_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_manual_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_cyber_btn_dark"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/cyber_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="输入已知设备的 IP 地址，直接测试连通性或查看针对该设备的激活秘籍："
        android:textColor="@color/cyber_text_secondary"
        android:textSize="12sp" />

    <!-- IP 输入框 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="目标 IP 地址:"
        android:textColor="@color/cyber_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_manual_ip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_cyber_edittext"
        android:fontFamily="monospace"
        android:hint="例如 192.168.1.100"
        android:inputType="textUri"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/cyber_neon_cyan"
        android:textColorHint="@color/cyber_text_muted"
        android:textSize="14sp" />

    <!-- 端口输入框 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="端口 (ADB默认 5555):"
        android:textColor="@color/cyber_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_manual_port"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_cyber_edittext"
        android:fontFamily="monospace"
        android:hint="5555"
        android:inputType="number"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="5555"
        android:textColor="@color/cyber_neon_cyan"
        android:textColorHint="@color/cyber_text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_manual_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#0A0E17"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:text="准备测试连通性..."
        android:textColor="@color/cyber_text_secondary"
        android:textSize="11sp" />

    <!-- 按钮操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_manual_test"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cyber_btn_solid_cyan"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="⚡ 测试并复制"
            android:textColor="#090D14"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_manual_diagnose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cyber_btn_outline_amber"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="进入诊断"
            android:textColor="@color/cyber_amber"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
