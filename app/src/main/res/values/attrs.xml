<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 环形进度条属性 -->
    <declare-styleable name="CircularProgressView">
        <attr name="cpv_progress" format="integer" />
        <attr name="cpv_stroke_width" format="dimension" />
        <attr name="cpv_progress_color" format="color" />
        <attr name="cpv_track_color" format="color" />
        <attr name="cpv_text_color" format="color" />
        <attr name="cpv_text_size" format="dimension" />
    </declare-styleable>

    <!-- 线性进度条属性 -->
    <declare-styleable name="LinearProgressView">
        <attr name="lpv_progress" format="integer" />
        <attr name="lpv_height" format="dimension" />
        <attr name="lpv_progress_color" format="color" />
        <attr name="lpv_track_color" format="color" />
    </declare-styleable>

    <!-- 动态渐变流光文字属性 -->
    <declare-styleable name="AnimatedGradientTextView">
        <attr name="gradient_style" format="enum">
            <enum name="gold" value="0" />
            <enum name="cyan" value="1" />
            <enum name="flame" value="2" />
            <enum name="rainbow" value="3" />
        </attr>
        <attr name="gradient_speed" format="integer" />
    </declare-styleable>
</resources>